const DATA={in:[],fix:[]};const KEY='weeklyPartsReportClassifications';let classes={};try{classes=JSON.parse(localStorage.getItem(KEY)||'{}')}catch{};const getClass=n=>classes[n]||'';const setClass=(n,v)=>{if(v)classes[n]=v;else delete classes[n];localStorage.setItem(KEY,JSON.stringify(classes));render()};const dateOnly=s=>s.slice(0,10);const fmtDate=s=>new Date(s).toLocaleDateString('en-GB',{day:'2-digit',month:'short'});const startMon=s=>{let d=new Date(s+'T00:00:00');d.setDate(d.getDate()-(d.getDay()+6)%7);return d.toISOString().slice(0,10)};const wlabel=k=>{let a=new Date(k+'T00:00:00'),b=new Date(a);b.setDate(b.getDate()+5);return `${a.toLocaleDateString('en-GB',{day:'2-digit',month:'short'})} – ${b.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}`};const weeks=[...new Set([...DATA.in,...DATA.fix].map(x=>startMon(dateOnly(x.date))))].sort();const sel=document.getElementById('week');weeks.forEach(k=>{let o=document.createElement('option');o.value=k;o.textContent=wlabel(k);sel.append(o)});if(weeks.length)sel.value=weeks[weeks.length-1];function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function current(){let k=sel.value;return {in:DATA.in.filter(x=>startMon(dateOnly(x.date))===k),fix:DATA.fix.filter(x=>startMon(dateOnly(x.date))===k)}}function clsSelect(n){return `<select class="tagselect" data-name="${esc(n)}" onchange="setClass(this.dataset.name,this.value)"><option value="" ${!getClass(n)?'selected':''}>ບໍ່ຈັດປະເພດ</option><option ${getClass(n)==='Electronic'?'selected':''}>Electronic</option><option ${getClass(n)==='Wear/Tear'?'selected':''}>Wear/Tear</option></select>`}function barRows(obj,color=''){let vals=Object.entries(obj).sort((a,b)=>b[1]-a[1]);let max=Math.max(1,...vals.map(x=>x[1]));return vals.length?vals.map(([n,v])=>`<div class="barrow"><span title="${esc(n)}">${esc(n)}</span><div class="track"><div class="fill ${color}" style="width:${v/max*100}%">