.qty;let t=getClass(x.name)||'ຍັງບໍ່ຈັດປະເພດ';fc[t].qty+=x.qty;fc[t].parts.add(x.name)});document.getElementById('fixkpis').innerHTML=kpi('ສ້ອມ/ນຳໃຊ້ໄດ້',fUnits,'ຊິ້ນຍ້າຍເຂົ້າ Lao-usable')+kpi('ລາຍການສ້ອມ',fix.length,'ແຖວຢືນຢັນ')+kpi('ຊື່ອາໄຫຼ່',fNames.size,'ປະເພດບໍ່ຊ້ຳ')+kpi('ຜູ້ສ້ອມ',Object.keys(tech).length,'ຄົນ/ຊື່ທີ່ລະບຸ');document.getElementById('techs').innerHTML=barRows(tech,'teal');document.getElementById('fixtypes').innerHTML=typeSummary(fc);let ft=document.getElementById('fixtable'),fq=document.getElementById('fixsearch').value.toLowerCase();ft.innerHTML=fix.filter(x=>(x.name+x.who+x.work).toLowerCase().includes(fq)).map(x=>`<tr><td>${fmtDate(x.date)}</td><td><b>${esc(x.name)}</b></td><td>${esc(getClass(x.name)||'ບໍ່ຈັດປະເພດ')}</td><td>${x.qty}</td><td>${esc(x.who)}</td><td>${esc(x.work)}</td></tr>`).join('')||'<tr><td colspan="6" class="empty">ບໍ່ພົບລາຍການ</td></tr>'}document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active')});sel.onchange=render;document.getElementById('insearch').oninput=render;document.getElementById('fixsearch').oninput=render;render();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            

